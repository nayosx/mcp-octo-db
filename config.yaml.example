# Copy this file to config.yaml and replace placeholders with your real values.

databases:
  default:
    type: postgres
    host: 127.0.0.1
    port: "5432"
    user: appuser
    password: change_me
    name: appdb
    sslmode: disable

  analytics:
    type: mysql
    host: 127.0.0.1
    port: "3306"
    user: analytics_user
    password: change_me
    name: analytics_db

  local_sqlite:
    type: sqlite
    name: /absolute/path/to/local.db

settings:
  enable_write: false
  max_rows: 500
  query_timeout_seconds: 10
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime_seconds: 300
  conn_max_idle_time_seconds: 180
  allowed_schemas:
    - public
    - analytics
  allowed_tables:
    - users
    - orders
  denied_tables:
    - secrets
    - audit_backups
  log_level: info
  log_format: text
  audit_log: false
