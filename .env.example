# ==============================================================================
# octo-db Environment Configuration Template
#
# Copy this file to ".env" and replace the placeholders with your actual settings.
# Ensure that your .env file is kept out of version control for security.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configurations (Primary: OCTO_DB_ prefix)
# ------------------------------------------------------------------------------

# The suffix of the database to use as the default connection when no specific
# database name is requested by the MCP client.
OCTO_DB_DEFAULT=main

# -- Default Connection (main) --
# OCTO_DB_<NAME>_DRIVER: Driver/Type of the database (mysql, mariadb, postgres, postgresql, sqlite, sqlite3).
OCTO_DB_MAIN_DRIVER=mysql
# OCTO_DB_<NAME>_HOST: Host IP or hostname of the database server.
OCTO_DB_MAIN_HOST=localhost
# OCTO_DB_<NAME>_PORT: Port number of the database server (defaults: mysql=3306, postgres=5432).
OCTO_DB_MAIN_PORT=3306
# OCTO_DB_<NAME>_DATABASE: Name of the database to connect to, or file path for SQLite.
OCTO_DB_MAIN_DATABASE=my_database
# OCTO_DB_<NAME>_USER: Database username.
OCTO_DB_MAIN_USER=my_user
# OCTO_DB_<NAME>_PASSWORD: Database password.
OCTO_DB_MAIN_PASSWORD=change_me
# OCTO_DB_<NAME>_SSLMODE: SSL mode for Postgres connection (e.g., disable, require, verify-ca, verify-full).
OCTO_DB_MAIN_SSLMODE=disable

# -- Secondary Connection (analytics) --
# Example of configuring an additional connection to a PostgreSQL database.
# OCTO_DB_ANALYTICS_DRIVER=postgres
# OCTO_DB_ANALYTICS_HOST=localhost
# OCTO_DB_ANALYTICS_PORT=5432
# OCTO_DB_ANALYTICS_DATABASE=analytics_db
# OCTO_DB_ANALYTICS_USER=analytics_user
# OCTO_DB_ANALYTICS_PASSWORD=change_me
# OCTO_DB_ANALYTICS_SSLMODE=disable

# -- SQLite Connection (local) --
# Example of configuring an additional connection to a local SQLite database file.
# OCTO_DB_LOCAL_DRIVER=sqlite
# OCTO_DB_LOCAL_DATABASE=/absolute/path/to/local.db

# ------------------------------------------------------------------------------
# MCP Server Settings
# ------------------------------------------------------------------------------

# Enable write operations (INSERT, UPDATE, DELETE, CREATE, etc.) via the write_query tool.
# WARNING: Setting this to true exposes high risk write privileges to the agent.
OCTO_DB_ENABLE_WRITE=false

# Maximum number of rows returned by read_query or get_table_sample tools to protect context size and performance.
OCTO_DB_MAX_ROWS=500

# Query execution timeout in seconds.
OCTO_DB_QUERY_TIMEOUT_SECONDS=10

# Database Connection Pool Settings
OCTO_DB_MAX_OPEN_CONNS=10
OCTO_DB_MAX_IDLE_CONNS=5
OCTO_DB_CONN_MAX_LIFETIME_SECONDS=300
OCTO_DB_CONN_MAX_IDLE_TIME_SECONDS=180

# Security policy lists (comma-separated, case-insensitive)
# OCTO_DB_ALLOWED_SCHEMAS: List schemas that are accessible.
OCTO_DB_ALLOWED_SCHEMAS=public,analytics
# OCTO_DB_ALLOWED_TABLES: List specific tables allowed. If empty, all tables are allowed except denied.
OCTO_DB_ALLOWED_TABLES=users,orders
# OCTO_DB_DENIED_TABLES: List tables that must never be accessed.
OCTO_DB_DENIED_TABLES=secrets,audit_backups

# Logging settings
# Log Level: debug, info, warn, error
OCTO_DB_LOG_LEVEL=info
# Log Format: text, json
OCTO_DB_LOG_FORMAT=text
# Audit Log: Record all executed tools and queries on stderr.
OCTO_DB_AUDIT_LOG=false

# Note: The server maintains backward compatibility with older environment variables 
# prefixed with DB_ (e.g., DB_NAME, DB_TYPE) and MCP_ (e.g., MCP_ENABLE_WRITE).
